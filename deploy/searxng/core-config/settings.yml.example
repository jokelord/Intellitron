use_default_settings:
  engines:
    keep_only:
      # 英文通用搜索
      - google
      - startpage
      - mojeek
      - duckduckgo
      # 学术 / 论文 / DOI
      # - google scholar
      # - semantic scholar
      # - openalex
      # - arxiv
      # - crossref
      # 中国大陆搜索
      - baidu
      - 360search
      - sogou
      - chinaso news

general:
  debug: false
  instance_name: "LLM-deployment local search"

search:
  safe_search: 0
  autocomplete: ""
  favicon_resolver: ""
  #  default_lang: "zh-CN"
  default_lang: "all"
  ban_time_on_fail: 5
  max_ban_time_on_fail: 120
  formats:
    - html
    - json

server:
  secret_key: "REPLACE WITH YOUR SECRET KEY"
  limiter: false
  image_proxy: true

valkey:
  url: redis://valkey:6379/0

outgoing:
  request_timeout: 60.0
  max_request_timeout: 60.0

engines:
  
  # 中国大陆以外引擎：显式走 V2rayN 代理

  - name: google
    disabled: false
    proxies:
      all://:
        - http://host.docker.internal:10808

  - name: duckduckgo
    disabled: false
    proxies:
      all://:
        - http://host.docker.internal:10808

  # - name: bing
  #   disabled: false
  #   proxies:
  #     http://:
  #       - http://172.18.0.1:10808
  #     https://:
  #       - http://172.18.0.1:10808

  # - name: brave
  #   disabled: false
  #   proxies:
  #     http://:
  #       - http://172.18.0.1:10808
  #     https://:
  #       - http://172.18.0.1:10808

  - name: startpage
    disabled: false
    proxies:
      all://:
        - http://host.docker.internal:10808

  - name: mojeek
    disabled: false
    proxies:
      all://:
        - http://host.docker.internal:10808

  - name: google scholar
    disabled: false
    proxies:
      all://:
        - http://host.docker.internal:10808

  - name: semantic scholar
    disabled: false
    proxies:
      all://:
        - http://host.docker.internal:10808

  - name: openalex
    disabled: false
    proxies:
      all://:
        - http://host.docker.internal:10808

  - name: arxiv
    disabled: false
    proxies:
      all://:
        - http://host.docker.internal:10808

  - name: crossref
    disabled: false
    proxies:
      all://:
        - http://host.docker.internal:10808

 # 中国大陆搜索引擎：不配置 proxies，保持直连

  - name: baidu
    disabled: false

  - name: 360search
    disabled: false

  - name: sogou
    disabled: false

  - name: chinaso news
    disabled: false
    inactive: false

